# ─────────────────────────────────────────────────────────────
# DeepResearch Agent — local dev configuration
# 真实模式：USE_MOCK_MODEL=false + USE_MOCK_SEARCH=false。
# 模型走 taotoken.net 的 OpenAI 兼容代理（base_url 必须带 /v1，
#   否则 /api/chat/completions 返回 401），搜索走 Tavily。
# API 服务启动时不连接任何外部 DB（SQLite TraceDB + 文件系统 VFS）。
# ─────────────────────────────────────────────────────────────

# ── 模型（真实）──
USE_MOCK_MODEL=false
MODEL_API_KEY=
MODEL_BASE_URL=https://api.siliconflow.cn/v1
MODEL_NAME=deepseek-ai/DeepSeek-V4-Flash

# ── 搜索（真实：Tavily）──
USE_MOCK_SEARCH=false
SEARCH_API_KEY=

# ── 数据库（默认值；启动时不会连接，仅真实研究流程会用到）──
MYSQL_HOST=127.0.0.1
MYSQL_USER=deepresearch
MYSQL_PASSWORD=
MYSQL_DB=deepresearch
REDIS_URL=redis://127.0.0.1:6379/0
CHROMA_PATH=./data/chroma_data

# ── Trace / VFS / 检查点（本地文件系统）──
TRACE_DIR=./data/traces
TRACE_STDOUT=true
VIRTUAL_FS_ROOT=./data/virtual_fs
CHECKPOINT_DIR=./data/checkpoints

# ── Citation 策略：flag | delete | keep_as_is ──
CITATION_POLICY=flag
